# Copy to .env for local use. Values are dummy, development-only defaults.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/order_to_audit
APP_ENV=dev
# Set a real value in any shared environment; never commit it.
JWT_SECRET=change-me

# Tests connect ONLY to this disposable server (never to DATABASE_URL).
# Start it with: docker compose --profile test up -d db-test
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5433/postgres
